{
  "name": "actor_critic_grid_v1",
  "protocol": "actor_critic_v1",
  "description": "Pre-registered Actor-Critic (PPO) reinforcement learning benchmark on single-niche gridworld under strict interaction budget (research/protocols/actor_critic_v1.md).",
  "env": {
    "height": 10,
    "width": 10,
    "max_steps": 100,
    "terrain": "random",
    "obstacle_density": 0.02,
    "n_resources": 5,
    "n_hazards": 0,
    "resource_regen": false,
    "step_penalty": 0.001,
    "wall_penalty": 0.0,
    "hazard_penalty": 0.25,
    "hazard_energy_drain": 5.0,
    "resource_reward": 1.0,
    "energy_start": 100.0,
    "energy_step": 0.1,
    "energy_capacity": 100.0,
    "seed": 0
  },
  "train_seeds": [11, 22, 33, 44],
  "test_seeds": [101, 202, 303, 404],
  "budget": 50000,
  "seeds": [300, 301, 302, 303, 304, 305, 306, 307],
  "include_baselines": ["random", "heuristic"],
  "transfer": {"adapt": false},
  "algorithms": {
    "ppo": {
      "hidden": [24],
      "episodes_per_update": 4,
      "actor_lr": 0.008,
      "critic_lr": 0.012,
      "gamma": 0.99,
      "lam": 0.95,
      "clip_eps": 0.2,
      "epochs_per_update": 4,
      "entropy_coef": 0.015
    },
    "reinforce": {
      "hidden": [24],
      "episodes_per_update": 4,
      "lr": 0.01,
      "gamma": 0.99,
      "entropy_coef": 0.02
    }
  }
}
