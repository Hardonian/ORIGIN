  "primary_comparison": {"method": "ppo", "baseline": "reinforce", "endpoint": "test_mean_reward", "bootstrap_seed": 20261019},
  "algorithms": {
    "ppo": {"hidden": [24], "episodes_per_update": 4, "actor_lr": 0.008, "critic_lr": 0.012, "gamma": 0.99, "lam": 0.95, "clip_eps": 0.2, "epochs_per_update": 4, "entropy_coef": 0.015},
    "reinforce": {"hidden": [24], "episodes_per_update": 4, "lr": 0.01, "gamma": 0.99, "entropy_coef": 0.02}
  }
