  "env": {
    "height": 10,
    "width": 10,
    "max_steps": 100,
    "terrain": "random",
    "obstacle_density": 0.02,
    "n_resources": 5,
    "n_hazards": 0,
    "resource_regen": false,
    "step_penalty": 0.001,
    "wall_penalty": 0.0,
    "hazard_penalty": 0.25,
