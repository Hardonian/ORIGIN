    "seed": 0
  },
  "train_seeds": [11, 22, 33, 44],
  "test_seeds": [101, 202, 303, 404],
  "budget": 500000,
  "seeds": [400, 401, 402, 403, 404, 405, 406, 407, 408, 409, 410, 411, 412, 413, 414, 415, 416, 417, 418, 419, 420, 421, 422, 423, 424, 425, 426, 427, 428, 429, 430, 431, 432, 433, 434, 435, 436, 437, 438, 439],
  "include_baselines": ["random", "heuristic"],
