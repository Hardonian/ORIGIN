{
  "name": "multi_niche_transfer_pilot",
  "protocol": "multi_niche_pilot_v1",
  "description": "Multi-Niche Grid World transfer pilot: testing whether Quality-Diversity (MAP-Elites) maintaining a 2D archive of resource-A and resource-B niche specializations adapts more effectively to ecological shocks (payoff swap, toxic niche, scarcity shock) than fixed-objective GA.",
  "env": {
    "height": 10,
    "width": 10,
    "max_steps": 120,
    "terrain": "random",
    "obstacle_density": 0.04,
    "n_resources": 4,
    "resource_reward": 1.0,
    "resource_energy": 20.0,
    "n_resources_b": 4,
    "resource_b_reward": 2.5,
    "resource_b_energy": 15.0,
    "n_hazards": 2,
    "hazard_penalty": 0.5,
    "hazard_energy_drain": 10.0,
    "obs_mode": "multi_niche",
    "niche_distribution": "zones",
    "energy_start": 100.0,
    "energy_capacity": 100.0,
    "energy_step": 0.1,
    "seed": 0
  },
  "train_seeds": [11, 22, 33, 44],
  "test_seeds": [101, 202, 303, 404],
  "budget": 25000,
  "seeds": [1, 2, 3, 4, 5],
  "include_baselines": ["random", "heuristic"],
  "transfer": {"adapt": true, "budget": 5000},
  "algorithms": {
    "fixed_objective_ga": {"pop_size": 24, "mutation_rate": 0.3, "mutation_scale": 0.5, "morph_strength": 0.3},
    "map_elites": {"batch": 12, "grid_shape": [8, 8], "mutation_rate": 0.3, "mutation_scale": 0.5, "morph_strength": 0.3}
  }
}
