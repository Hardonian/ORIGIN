{
  "name": "pilot_foraging",
  "protocol": "milestone8_initial_comparison",
  "description": "Pilot comparison of fixed-objective evolution, novelty search, quality-diversity and RL on a deterministic egocentric foraging task, with held-out seeds and morphology/perturbation transfer. Hazards are held out of training and used only as a robustness perturbation.",
  "env": {
    "height": 10,
    "width": 10,
    "max_steps": 140,
    "terrain": "random",
    "obstacle_density": 0.02,
    "n_resources": 5,
    "n_hazards": 0,
    "resource_regen": false,
    "step_penalty": 0.001,
    "wall_penalty": 0.0,
    "hazard_penalty": 0.25,
    "hazard_energy_drain": 5.0,
    "resource_reward": 1.0,
    "energy_start": 100.0,
    "energy_step": 0.1,
    "energy_capacity": 100.0,
    "seed": 0
  },
  "train_seeds": [11, 22, 33, 44],
  "test_seeds": [101, 202, 303, 404],
  "budget": 500000,
  "seeds": [1, 2, 3, 4, 5],
  "include_baselines": ["random", "heuristic"],
  "transfer": {"adapt": true, "budget": 50000},
  "algorithms": {
    "fixed_objective_ga": {"pop_size": 32, "mutation_rate": 0.3, "mutation_scale": 0.5, "morph_strength": 0.3},
    "novelty_search": {"pop_size": 32, "mutation_rate": 0.3, "mutation_scale": 0.5},
    "map_elites": {"batch": 16, "grid_shape": [10, 10], "mutation_rate": 0.3, "mutation_scale": 0.5, "morph_strength": 0.3},
    "reinforce": {"hidden": [24], "episodes_per_update": 4, "lr": 0.01, "gamma": 0.99, "entropy_coef": 0.02}
  }
}
