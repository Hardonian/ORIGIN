# ORIGIN environment configuration template
# Copy to .env and customize as needed.

# Secret API key for authentication.
# Required if binding to non-loopback interfaces (e.g. 0.0.0.0).
# On loopback (127.0.0.1), authentication is optional unless --require-auth is specified.
ORIGIN_API_KEY=

# Local directory storing SQLite DB, manifests, checkpoints, and artifacts.
ORIGIN_STORE=runs

# Host and port for origin-api service.
ORIGIN_API_HOST=127.0.0.1
ORIGIN_API_PORT=8788

# Lab UI API endpoint (used by Next.js browser client)
NEXT_PUBLIC_ORIGIN_API=http://127.0.0.1:8788

# Default API key preloaded into the Lab UI client (optional)
NEXT_PUBLIC_ORIGIN_API_KEY=

# E2E testing flag: set to 1 to run browser end-to-end tests
ORIGIN_E2E=0
